    <bpmn2:scriptTask id="_BBFD8437-DCED-47D6-925B-3554FDDB8AC1" name="INIT" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[INIT]]></drools:metaValue>
