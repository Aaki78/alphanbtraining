    <bpmn2:task id="_6BC8A3AF-48FA-4B42-B4FE-C3351BF00533" drools:taskName="Rest" name="Generate Policy Wordings">
      <bpmn2:documentation id="_DdgoMa_GEe-qEuuPmoFJDA"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Generate Policy Wordings]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[org.json.JSONObject obj  = new org.json.JSONObject();
org.json.JSONObject metadata_obj  = new org.json.JSONObject();


obj.put("contentType", "alpha-training-docs");
obj.put("policy_id", kcontext.getVariable("cid"));
obj.put("quote_id", kcontext.getVariable("cid"));
obj.put("contentId", 1);
obj.put("cid", kcontext.getVariable("cid"));
obj.put("pdfTemplateKey", "document");
obj.put("relative_path", kcontext.getVariable("cid"));
obj.put("name_space", "alpha_training:metadata");


metadata_obj.put("alpha_training:cid", kcontext.getVariable("cid"));

obj.put("metadata", metadata_obj);

kcontext.setVariable("payload",obj.toString());]]></drools:script>
        </drools:onEntry-script>
