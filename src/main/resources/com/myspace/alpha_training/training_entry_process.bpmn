    <bpmn2:task id="_66579D2A-E49E-46C9-89E3-3BB756A0C144" drools:taskName="Rest" name="Execute STP Rules">
      <bpmn2:documentation id="_02AJgq_mEe-UXMgkfY-xiQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Execute STP Rules]]></drools:metaValue>
        </drools:metaData>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[// Retrieve the JSON string from the process context
String stp_rules_response_str = (String) kcontext.getVariable("stp_rules_response");

if (stp_rules_response_str != null && !stp_rules_response_str.isEmpty()) {
    org.json.JSONObject stp_rules_response_str_obj = new org.json.JSONObject(stp_rules_response_str);

    // Check if the 'result' key exists in the JSON object
    if (stp_rules_response_str_obj.has("result")) {
        org.json.JSONObject stp_rules_response_result_obj = stp_rules_response_str_obj.getJSONObject("result");

        // Check if the 'stp' key exists within the 'result' object
        if (stp_rules_response_result_obj.has("stp")) {
            boolean stp_loc = stp_rules_response_result_obj.getBoolean("stp");

            // Log the retrieved value (for debugging purposes)
            System.out.println("Retrieved 'stp' value: " + stp_loc);

            // Assign the boolean value to the process variable
            kcontext.setVariable("stp", stp_loc);

        } else {
            System.out.println("'stp' key does not exist within the 'result' object.");
        }
    } else {
        System.out.println("'result' key does not exist in the JSON response.");
    }
} else {
    System.out.println("No JSON response or empty string provided.");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
