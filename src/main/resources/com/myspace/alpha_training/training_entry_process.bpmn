    <bpmn2:scriptTask id="_A352D981-DD60-46F7-A4FA-5B27266461BA" name="INIT" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[INIT]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_03FA55AE-32D8-492B-86C2-78717757FC54</bpmn2:incoming>
      <bpmn2:outgoing>_5B0BF5D7-9460-40AE-8C99-A3AC57CE497A</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("cid:"+kcontext.getVariable("cid")+",node:"+kcontext.getNodeInstance().getNodeName()+",process:"+kcontext.getProcessInstance().getProcessName());
System.setProperty("jbpm.loop.level.disabled","true");

//Set Base Path
String reels_in_url = (System.getenv("reels_in_url") != null) ? System.getenv("reels_in_url") : "https://sandbox.neutrinos-apps.com";

//Set API Method and Content Type
kcontext.setVariable("method","POST");
kcontext.setVariable("content_type","application/json");
kcontext.setVariable("is_handle_response_errors","true");

// Execute STP Rules
String stp_rules_path = reels_in_url + "/integration/api/runtime/sync";
kcontext.setVariable("stp_rules_url", stp_rules_path);

//Get Process Id
kcontext.setVariable("pid",kcontext.getProcessInstance().getId());

//Default Values
kcontext.setVariable("execute_rules", false);

Object stp_rules_request_obj = kcontext.getVariable("stp_rules_request");
if (stp_rules_request_obj == null) {
    System.out.println("No STP rules request data found.");
} else {
    try {
        // Check if the variable is indeed a LinkedHashMap (as parsed from JSON)
        if (stp_rules_request_obj instanceof java.util.LinkedHashMap) {
            java.util.LinkedHashMap<String, Object> stp_rules_map = (java.util.LinkedHashMap<String, Object>) stp_rules_request_obj;
            boolean executeRules = stp_rules_map.containsKey("version") && 
                                   stp_rules_map.containsKey("inputObj") && 
                                   stp_rules_map.containsKey("workflowId");
            kcontext.setVariable("execute_rules", executeRules);
            System.out.println("Execute rules set to: " + executeRules);
        } else {
            System.out.println("Unexpected data type for stp_rules_request: " + stp_rules_request_obj.getClass().getName());
        }
    } catch (Exception e) {
        System.out.println("Error processing STP rules request: " + e.getMessage());
    }
}]]></bpmn2:script>
    </bpmn2:scriptTask>
