    <bpmn2:task id="_8F88D1FC-FD54-4E82-8D73-F7925626BE7B" drools:taskName="Rest" name="Update Case Data">
      <bpmn2:documentation id="_BADaMa-5Ee-qEuuPmoFJDA"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Update Case Data]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[org.json.JSONObject obj = new org.json.JSONObject();
org.json.JSONObject mergedObject = new org.json.JSONObject();

// Get the existing case data
java.lang.String existing_case_data_str = (java.lang.String) kcontext.getVariable("fetchCaseResponse");

// Check if existing_case_data_str is not empty
if (existing_case_data_str != null && !existing_case_data_str.isEmpty()) {
    org.json.JSONObject case_data_obj = new org.json.JSONObject(existing_case_data_str);
    org.json.JSONObject existing_case_data_obj = case_data_obj.optJSONObject("caseData").optJSONObject("data");

    // Check if existing_case_data_obj is not null
    if (existing_case_data_obj != null) {
        java.util.Iterator<java.lang.String> existing_caseKeys = existing_case_data_obj.keys();
        while (existing_caseKeys.hasNext()) {
            java.lang.String key = existing_caseKeys.next();
            mergedObject.put(key, existing_case_data_obj.get(key));
        }
    }
}

System.out.println("------Merged CO--------" + mergedObject.toString());

// Get the new case data
java.lang.String case_data_str = (java.lang.String) kcontext.getVariable("case_data");

// Check if case_data_str is not empty
if (case_data_str != null && !case_data_str.isEmpty()) {
    org.json.JSONObject case_data_json = new org.json.JSONObject(case_data_str);

    java.util.Iterator<java.lang.String> caseKeys = case_data_json.keys();
    while (caseKeys.hasNext()) {
        java.lang.String key = caseKeys.next();
        mergedObject.put(key, case_data_json.get(key));
    }
}

System.out.println("--------Complete Merged Object" + mergedObject.toString());

obj.put("caseData", mergedObject);
obj.put("cid", kcontext.getVariable("cid"));

kcontext.setVariable("payload", obj.toString());]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
