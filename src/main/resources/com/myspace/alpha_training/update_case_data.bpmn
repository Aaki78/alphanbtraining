    <bpmn2:scriptTask id="_7C52E5F9-8C16-4F22-AB7C-2341D0F7F194" name="INIT" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[INIT]]></drools:metaValue>
        </drools:metaData>
