      <bpmn2:incoming>_280661DF-E62F-4C47-B9CC-8A146CDC2D68</bpmn2:incoming>
      <bpmn2:outgoing>_7D1CD489-BC83-42AE-8955-1E3E0EFCD5D7</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("cid:"+kcontext.getVariable("cid")+",node:"+kcontext.getNodeInstance().getNodeName()+",process:"+kcontext.getProcessInstance().getProcessName());
System.setProperty("jbpm.loop.level.disabled","true");

//Set Base Path
String baseCMUrl = (System.getenv("CM_BASE_URL") != null) ? System.getenv("CM_BASE_URL") : "https://sandbox.neutrinos-apps.com";

//Set API Method and Content Type
kcontext.setVariable("method","POST");
kcontext.setVariable("contentType","application/json");
kcontext.setVariable("isHandleResponseErrors","true");

// Fetch Case Path
String fetchCasePath = baseCMUrl + "/caseservice/case/instance/fetch";
kcontext.setVariable("fetchCaseUrl", fetchCasePath);

// Update Case Path
String updateCasePath = baseCMUrl + "/caseservice/case/instance/update-data";
kcontext.setVariable("updateCaseUrl", updateCasePath);]]></bpmn2:script>
    </bpmn2:scriptTask>
