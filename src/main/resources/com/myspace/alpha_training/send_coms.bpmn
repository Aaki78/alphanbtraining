    <bpmn2:scriptTask id="_DDD8E8AF-1BDA-48A4-AB7C-FD21F8D92BCC" name="INIT" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[INIT]]></drools:metaValue>
        </drools:metaData>
