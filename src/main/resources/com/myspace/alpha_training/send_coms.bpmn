      <bpmn2:incoming>_AD3AD5A2-FE08-4812-8038-901F8B118CEF</bpmn2:incoming>
      <bpmn2:outgoing>_CBB60A65-94B1-4FC4-9000-4A4DB1BB42AE</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("cid:"+kcontext.getVariable("cid")+",node:"+kcontext.getNodeInstance().getNodeName()+",process:"+kcontext.getProcessInstance().getProcessName());

System.setProperty("jbpm.loop.level.disabled","true");

//Set Base Path
String base_in_url = (System.getenv("IN_BASE_URL") != null) ? System.getenv("IN_BASE_URL") : "https://alpha-training.neutrinos-apps.com";

//Set API Method and Content Type
kcontext.setVariable("method","POST");
kcontext.setVariable("content_type","application/json");
kcontext.setVariable("is_handle_response_erros","true");

// Generate Policy Document Path
String send_coms_path = base_in_url + "/api/sendemail";
kcontext.setVariable("send_coms_url", send_coms_path);

if(kcontext.getVariable("attachment") == null || kcontext.getVariable("attachment") == "null"){
    kcontext.setVariable("attachment",false);
}]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="_0933F526-E3F8-4F45-ADDC-6D2CE8C7EB6C">
      <bpmn2:incoming>_EE8C0351-B1C8-47D0-9DCC-118913D9DA1E</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:startEvent id="_7E4EF43D-0278-4FB7-8189-9017FD4A955F">
      <bpmn2:outgoing>_AD3AD5A2-FE08-4812-8038-901F8B118CEF</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:task id="_C8DEE3DF-B48E-4C83-84FB-FD0E4F36C6DC" drools:taskName="Rest" name="Send Communications">
      <bpmn2:documentation id="_QZsFkK_YEe-qEuuPmoFJDA"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Send Communications]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[org.json.JSONObject obj  = new org.json.JSONObject();
org.json.JSONObject document_obj  = new org.json.JSONObject();

if(attachment) {
document_obj.put("alpha_training:cid", kcontext.getVariable("cid"));
org.json.JSONArray document_array = new org.json.JSONArray();
document_array.put(document_obj);
obj.put("document", document_array);
}

obj.put("contentId", kcontext.getVariable("contentId"));
obj.put("contentType", "alpha-training-mails");
obj.put("cid", kcontext.getVariable("cid"));


kcontext.setVariable("payload",obj.toString());]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
